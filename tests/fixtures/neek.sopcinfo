<?xml version="1.0" encoding="UTF-8"?>
<EnsembleReport name="neek" kind="neek" version="1.0" fabric="SOPC">
 <!-- Synthetic NEEK-style fixture: Nios2 + flash + I2C + SDRAM + onchip memory -->
 <!-- Matches boardinfo_neek.xml component names -->
 <module name="clk_0" kind="clock_source" version="13.1" path="clk_0">
  <interface name="clk" kind="clock_source" version="13.1">
   <parameter name="clockRate" value="50000000"/>
  </interface>
  <interface name="clk_reset" kind="reset_source" version="13.1">
  </interface>
 </module>
 <module name="cpu_0" kind="altera_nios2_qsys" version="13.1" path="cpu_0">
  <parameter name="embeddedsw.CMacro.CPU_FREQ" value="50000000"/>
  <parameter name="embeddedsw.CMacro.DCACHE_LINE_SIZE" value="32"/>
  <parameter name="embeddedsw.CMacro.ICACHE_LINE_SIZE" value="32"/>
  <parameter name="embeddedsw.CMacro.DCACHE_SIZE" value="2048"/>
  <parameter name="embeddedsw.CMacro.ICACHE_SIZE" value="4096"/>
  <interface name="clk" kind="clock_sink" version="13.1">
  </interface>
  <interface name="reset" kind="reset_sink" version="13.1">
  </interface>
  <interface name="data_master" kind="avalon_master" version="13.1">
   <parameter name="addressUnits" value="SYMBOLS"/>
  </interface>
  <interface name="instruction_master" kind="avalon_master" version="13.1">
   <parameter name="addressUnits" value="SYMBOLS"/>
  </interface>
  <interface name="d32" kind="interrupt_receiver" version="13.1">
  </interface>
 </module>
 <module name="ext_flash" kind="altera_avalon_cfi_flash" version="13.1" path="ext_flash">
  <interface name="clk" kind="clock_sink" version="13.1">
  </interface>
  <interface name="reset" kind="reset_sink" version="13.1">
  </interface>
  <interface name="s1" kind="avalon_slave" version="13.1">
   <parameter name="addressSpan" value="4194304"/>
  </interface>
  <interface name="out_clken" kind="conduit_end" version="13.1">
  </interface>
 </module>
 <module name="ddr_sdram" kind="altera_avalon_new_sdram_controller" version="13.1" path="ddr_sdram">
  <interface name="clk" kind="clock_sink" version="13.1">
  </interface>
  <interface name="reset" kind="reset_sink" version="13.1">
  </interface>
  <interface name="s1" kind="avalon_slave" version="13.1">
   <parameter name="addressSpan" value="67108864"/>
  </interface>
  <interface name="wire" kind="conduit_end" version="13.1">
  </interface>
 </module>
 <module name="onchip_memory2_0" kind="altera_avalon_onchip_memory2" version="13.1" path="onchip_memory2_0">
  <interface name="clk1" kind="clock_sink" version="13.1">
  </interface>
  <interface name="reset1" kind="reset_sink" version="13.1">
  </interface>
  <interface name="s1" kind="avalon_slave" version="13.1">
   <parameter name="addressSpan" value="65536"/>
  </interface>
 </module>
 <module name="i2c_1" kind="opencores_i2c_master" version="13.1" path="i2c_1">
  <interface name="clk" kind="clock_sink" version="13.1">
  </interface>
  <interface name="reset" kind="reset_sink" version="13.1">
  </interface>
  <interface name="s1" kind="avalon_slave" version="13.1">
   <parameter name="addressSpan" value="32"/>
  </interface>
  <interface name="irq" kind="interrupt_sender" version="13.1">
  </interface>
  <interface name="export" kind="conduit_end" version="13.1">
  </interface>
 </module>
 <module name="jtag_uart_0" kind="altera_avalon_jtag_uart" version="13.1" path="jtag_uart_0">
  <interface name="clk" kind="clock_sink" version="13.1">
  </interface>
  <interface name="reset" kind="reset_sink" version="13.1">
  </interface>
  <interface name="avalon_jtag_slave" kind="avalon_slave" version="13.1">
   <parameter name="addressSpan" value="8"/>
  </interface>
  <interface name="irq" kind="interrupt_sender" version="13.1">
  </interface>
 </module>
 <!-- Clock connections -->
 <connection kind="clock" version="13.1">
  <startModule>clk_0</startModule>
  <startConnectionPoint>clk</startConnectionPoint>
  <endModule>cpu_0</endModule>
  <endConnectionPoint>clk</endConnectionPoint>
 </connection>
 <connection kind="clock" version="13.1">
  <startModule>clk_0</startModule>
  <startConnectionPoint>clk</startConnectionPoint>
  <endModule>ext_flash</endModule>
  <endConnectionPoint>clk</endConnectionPoint>
 </connection>
 <connection kind="clock" version="13.1">
  <startModule>clk_0</startModule>
  <startConnectionPoint>clk</startConnectionPoint>
  <endModule>ddr_sdram</endModule>
  <endConnectionPoint>clk</endConnectionPoint>
 </connection>
 <connection kind="clock" version="13.1">
  <startModule>clk_0</startModule>
  <startConnectionPoint>clk</startConnectionPoint>
  <endModule>onchip_memory2_0</endModule>
  <endConnectionPoint>clk1</endConnectionPoint>
 </connection>
 <connection kind="clock" version="13.1">
  <startModule>clk_0</startModule>
  <startConnectionPoint>clk</startConnectionPoint>
  <endModule>i2c_1</endModule>
  <endConnectionPoint>clk</endConnectionPoint>
 </connection>
 <connection kind="clock" version="13.1">
  <startModule>clk_0</startModule>
  <startConnectionPoint>clk</startConnectionPoint>
  <endModule>jtag_uart_0</endModule>
  <endConnectionPoint>clk</endConnectionPoint>
 </connection>
 <!-- Reset connections -->
 <connection kind="reset" version="13.1">
  <startModule>clk_0</startModule>
  <startConnectionPoint>clk_reset</startConnectionPoint>
  <endModule>cpu_0</endModule>
  <endConnectionPoint>reset</endConnectionPoint>
 </connection>
 <connection kind="reset" version="13.1">
  <startModule>clk_0</startModule>
  <startConnectionPoint>clk_reset</startConnectionPoint>
  <endModule>ext_flash</endModule>
  <endConnectionPoint>reset</endConnectionPoint>
 </connection>
 <connection kind="reset" version="13.1">
  <startModule>clk_0</startModule>
  <startConnectionPoint>clk_reset</startConnectionPoint>
  <endModule>ddr_sdram</endModule>
  <endConnectionPoint>reset</endConnectionPoint>
 </connection>
 <connection kind="reset" version="13.1">
  <startModule>clk_0</startModule>
  <startConnectionPoint>clk_reset</startConnectionPoint>
  <endModule>onchip_memory2_0</endModule>
  <endConnectionPoint>reset1</endConnectionPoint>
 </connection>
 <connection kind="reset" version="13.1">
  <startModule>clk_0</startModule>
  <startConnectionPoint>clk_reset</startConnectionPoint>
  <endModule>i2c_1</endModule>
  <endConnectionPoint>reset</endConnectionPoint>
 </connection>
 <connection kind="reset" version="13.1">
  <startModule>clk_0</startModule>
  <startConnectionPoint>clk_reset</startConnectionPoint>
  <endModule>jtag_uart_0</endModule>
  <endConnectionPoint>reset</endConnectionPoint>
 </connection>
 <!-- Avalon (memory-mapped) connections -->
 <connection kind="avalon" version="13.1">
  <startModule>cpu_0</startModule>
  <startConnectionPoint>data_master</startConnectionPoint>
  <endModule>ext_flash</endModule>
  <endConnectionPoint>s1</endConnectionPoint>
  <parameter name="baseAddress" value="0x00000000"/>
 </connection>
 <connection kind="avalon" version="13.1">
  <startModule>cpu_0</startModule>
  <startConnectionPoint>data_master</startConnectionPoint>
  <endModule>ddr_sdram</endModule>
  <endConnectionPoint>s1</endConnectionPoint>
  <parameter name="baseAddress" value="0x00800000"/>
 </connection>
 <connection kind="avalon" version="13.1">
  <startModule>cpu_0</startModule>
  <startConnectionPoint>data_master</startConnectionPoint>
  <endModule>onchip_memory2_0</endModule>
  <endConnectionPoint>s1</endConnectionPoint>
  <parameter name="baseAddress" value="0x04000000"/>
 </connection>
 <connection kind="avalon" version="13.1">
  <startModule>cpu_0</startModule>
  <startConnectionPoint>data_master</startConnectionPoint>
  <endModule>i2c_1</endModule>
  <endConnectionPoint>s1</endConnectionPoint>
  <parameter name="baseAddress" value="0x04010000"/>
 </connection>
 <connection kind="avalon" version="13.1">
  <startModule>cpu_0</startModule>
  <startConnectionPoint>data_master</startConnectionPoint>
  <endModule>jtag_uart_0</endModule>
  <endConnectionPoint>avalon_jtag_slave</endConnectionPoint>
  <parameter name="baseAddress" value="0x04010020"/>
 </connection>
 <connection kind="avalon" version="13.1">
  <startModule>cpu_0</startModule>
  <startConnectionPoint>instruction_master</startConnectionPoint>
  <endModule>onchip_memory2_0</endModule>
  <endConnectionPoint>s1</endConnectionPoint>
  <parameter name="baseAddress" value="0x04000000"/>
 </connection>
 <!-- Interrupt connections -->
 <connection kind="interrupt" version="13.1">
  <startModule>i2c_1</startModule>
  <startConnectionPoint>irq</startConnectionPoint>
  <endModule>cpu_0</endModule>
  <endConnectionPoint>d32</endConnectionPoint>
  <parameter name="irqNumber" value="0"/>
 </connection>
 <connection kind="interrupt" version="13.1">
  <startModule>jtag_uart_0</startModule>
  <startConnectionPoint>irq</startConnectionPoint>
  <endModule>cpu_0</endModule>
  <endConnectionPoint>d32</endConnectionPoint>
  <parameter name="irqNumber" value="1"/>
 </connection>
</EnsembleReport>
